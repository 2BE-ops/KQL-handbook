// =====================================================================
// QUERY 2 — Custom detection: flush on an MDE-isolated host
// Save as a custom detection rule (needs Timestamp, DeviceId, ReportId).
// Isolation evidence = mde_netfilter INITIATING a firewall binary, i.e.
// actual isolation rule application. Do NOT use "has mde_netfilter" on
// command lines — wdavdaemon health-checks the service constantly and
// would mark the whole fleet as isolated.
// =====================================================================
let Lookback = 24h;   // tighten for a scheduled detection
let FirewallBinaries = dynamic([
    "iptables","ip6tables","iptables-nft","ip6tables-nft",
    "iptables-legacy","ip6tables-legacy",
    "xtables-nft-multi","xtables-legacy-multi","nft"]);
let IsolationApplied =
    DeviceProcessEvents
    | where Timestamp > ago(30d)
    | where InitiatingProcessFileName =~ "mde_netfilter"
    | where FileName in~ (FirewallBinaries)
    | summarize IsolationFirstSeen = min(Timestamp) by DeviceId;
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| where FileName in~ (FirewallBinaries)
| where ProcessCommandLine matches regex @"(^|\s)(-F|--flush)(\s|$)"
     or (FileName =~ "nft" and ProcessCommandLine matches regex @"\bflush\s+(ruleset|table|chain)\b")
| where InitiatingProcessFileName !~ "mde_netfilter"
| join kind=inner IsolationApplied on DeviceId
| where Timestamp >= IsolationFirstSeen
| project Timestamp, DeviceId, DeviceName, ReportId, AccountName,
          ProcessCommandLine, InitiatingProcessFileName,
          InitiatingProcessCommandLine, InitiatingProcessAccountName,
          IsolationFirstSeen
